{
  "name": "mellith",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=@mellith/client",
    "dev:server": "turbo dev --filter=@mellith/server",
    "build": "turbo build",
    "build:client": "turbo build --filter=@mellith/client",
    "build:server": "turbo build --filter=@mellith/server",
    "db:generate": "bun run --filter @mellith/db db:generate",
    "db:migrate": "bun run --filter @mellith/db db:migrate",
    "db:push": "bun run --filter @mellith/db db:push",
    "db:studio": "bun run --filter @mellith/db db:studio",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "type-check": "turbo type-check",
    "format:check": "oxfmt --check",
    "postinstall": "turbo build --filter=@mellith/types --filter=@mellith/db --filter=@mellith/server",
    "format": "oxfmt --write"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.6.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
